# Optional. The app starts and is fully usable with no key at all -- Recorded/Replay mode
# and Safe mode (the deterministic dispatcher) both need no key and no network. A key only
# unlocks Live mode (real Gemini calls), and even then falls back to Safe mode automatically
# on any call failure. Get a free key (no credit card) at https://aistudio.google.com.
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-3.5-flash-lite
